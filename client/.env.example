# Copy this file to .env.local and fill in the values from Supabase → Project Settings → API Keys.
# Use the PUBLISHABLE (anon) key only. Never put the secret/service_role key in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional, only for `npm run check:security` (a test CUSTOMER account, never an admin):
# Put the password in double quotes — a # inside an unquoted value is read as a comment.
# TEST_CUSTOMER_EMAIL=
# TEST_CUSTOMER_PASSWORD="..."
